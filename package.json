{
  "name": "pai-api-gateway",
  "description": "PAI API Gateway - Cloudflare Worker API Gateway with Hono, JWT auth, rate limiting, caching",
  "version": "1.0.0",
  "dependencies": {
    "@axiomid/crypto": "^0.1.0",
    "@axiomid/sdk": "^0.1.0",
    "@pai/identity": "^0.1.0",
    "@pai/verify": "^0.1.0",
    "@pai/wallet": "^0.1.0",
    "hono": "^4.6.5",
    "jose": "^5.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.0.17",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types"
  },
  "type": "module",
  "types": "src/types/index.ts"
}
